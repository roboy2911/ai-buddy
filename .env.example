# --- Required ---
# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your Minecraft username (so the buddy knows who you are)
PLAYER_NAME=Steve

# --- Minecraft connection ---
MC_HOST=localhost
MC_PORT=25565
# Leave empty to auto-detect. Set it (e.g. 1.21.11) if joining fails.
MC_VERSION=
# The buddy's in-game name
BOT_NAME=Buddy
# offline = works on servers with online-mode=false (see README)
# microsoft = log the buddy in with a second Microsoft account that owns Minecraft
BOT_AUTH=offline

# --- AI brain ---
MODEL=claude-opus-5-5
# low = fastest replies. medium/high = smarter but slower.
EFFORT=low

# --- Voice ---
# Kokoro voice. Try: am_michael, am_adam, af_heart, af_bella, bm_george, bf_emma
VOICE=am_michael
VOICE_SPEED=1.1
# Whisper model for hearing you. base.en is a good balance; small.en is more accurate but slower.
WHISPER_MODEL=onnx-community/whisper-base.en

# Port for the voice page (open http://localhost:3000 in Chrome or Edge)
WEB_PORT=3000
